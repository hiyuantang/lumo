# SPDX-License-Identifier: AGPL-3.0-only
FROM node:22-bookworm AS web
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY index.html tsconfig.json vite.config.ts playwright.config.ts ./
COPY src/ src/
COPY tests/ tests/
RUN VITE_LUMIO_LIVE=1 npm run build

FROM golang:1.26-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends libpam0g-dev gcc
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
COPY --from=web /src/dist ./internal/static/dist
RUN CGO_ENABLED=1 go build -tags pam,webdist -o /out/lumiod ./cmd/lumiod

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker
RUN apt-get update && apt-get install -y --no-install-recommends systemd systemd-sysv dbus polkitd python3 curl openssl ca-certificates libpam0g libpam-modules iproute2 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/lumio-test
COPY --from=build /out/lumiod ./lumiod
COPY scripts/install.py scripts/install.sh scripts/install-container-check.py ./scripts/
COPY docker/os.lumio.policy ./docker/
COPY deploy/ ./deploy/
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]
