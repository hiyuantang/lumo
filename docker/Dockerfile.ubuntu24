# SPDX-License-Identifier: AGPL-3.0-only
FROM lumo-test-build:deps AS build
WORKDIR /lumo-test-src
COPY server/ ./
COPY dist/ ./internal/static/dist/
ENV GOPROXY=off GOSUMDB=off GOTOOLCHAIN=local
RUN CGO_ENABLED=1 go test -tags pam ./...
RUN CGO_ENABLED=1 go build -tags pam,webdist -o /out/lumod ./cmd/lumod

FROM lumo-test-runtime:deps
ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker

RUN (id lumo-gw >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin lumo-gw) \
    && (id alice >/dev/null 2>&1 || useradd --create-home --shell /bin/bash --groups systemd-journal alice) \
    && echo 'alice:alice-pass' | chpasswd

COPY --from=build /out/lumod /usr/local/bin/lumod
COPY docker/lumod-gateway.service docker/lumod-sessiond.service docker/lumod-broker.service /etc/systemd/system/
COPY docker/pam.d-lumod /etc/pam.d/lumod
COPY docker/os.lumo.policy /usr/share/polkit-1/actions/os.lumo.policy
COPY docker/os.lumo-testbed.rules /etc/polkit-1/rules.d/90-lumo-testbed.rules
COPY docker/lumo-test-web.py /usr/local/lib/lumo-test-web.py
COPY docker/lumo-test-web.service /etc/systemd/system/lumo-test-web.service

RUN printf 'd /run/sshd 0755 root root -\n' > /etc/tmpfiles.d/lumo-testbed.conf \
    && printf '{"port":-1}\n' > /etc/lumo-test-web.json \
    && chmod 0644 /etc/lumo-test-web.json /usr/local/lib/lumo-test-web.py \
    && systemctl enable lumod-gateway.service lumod-sessiond.service lumod-broker.service lumo-test-web.service

COPY docker/test-relay.py /opt/lumo-test/test-relay.py
COPY docker/test-fixtures.py /opt/lumo-test/test-fixtures.py
RUN python3 /opt/lumo-test/test-fixtures.py

STOPSIGNAL SIGRTMIN+3

EXPOSE 8080

ENTRYPOINT ["/sbin/init"]
