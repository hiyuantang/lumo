# SPDX-License-Identifier: AGPL-3.0-only
FROM node:22-bookworm AS node-runtime

FROM golang:1.26-bookworm AS build-deps
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpam0g-dev gcc \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src/server
COPY server/go.mod server/go.sum ./
COPY apps/go.mod apps/go.sum ../apps/
COPY plugin-sdk/go.mod ../plugin-sdk/
RUN go mod download

FROM ubuntu:24.04 AS runtime-deps
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus cron curl ca-certificates policykit-1 \
        libpam-runtime libpam-modules sqlite3 openssh-server python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
