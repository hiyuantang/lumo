# SPDX-License-Identifier: AGPL-3.0-only
FROM golang:1.26-bookworm AS build-deps
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpam0g-dev gcc \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download

FROM ubuntu:24.04 AS runtime-deps
ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus cron curl ca-certificates policykit-1 \
        libpam-runtime libpam-modules sqlite3 openssh-server python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
