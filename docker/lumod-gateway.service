[Unit]
Description=Lumo web gateway
After=lumod-sessiond.service lumod-broker.service
Wants=lumod-sessiond.service lumod-broker.service

[Service]
Type=simple
User=lumo-gw
ExecStart=/usr/local/bin/lumod gateway -addr 0.0.0.0:8080 -insecure-http
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
