polkit.addRule(function(action, subject) {
    var actions = [
        "os.lumio.services.manage",
        "os.lumio.packages.apply",
        "os.lumio.files.write-privileged",
        "os.lumio.system.power",
        "os.lumio.network.apply"
    ];
    if (actions.indexOf(action.id) !== -1) {
        return subject.isInGroup("lumio-admin") ? polkit.Result.AUTH_SELF : polkit.Result.NO;
    }
});
