{
  "schemaVersion": 1,
  "id": "containers",
  "name": "Docker",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "hostApiVersion": 1,
  "icon": "IconBoxes",
  "window": {
    "width": 920,
    "height": 610,
    "minWidth": 390,
    "minHeight": 380
  },
  "requiredPackage": "docker",
  "backend": {
    "protocolVersion": 1,
    "routes": [
      "GET /api/v1/containers",
      "GET /api/v1/containers/detail",
      "GET /api/v1/containers/logs",
      "POST /api/v1/containers/action",
      "GET /api/v1/docker/resources",
      "POST /api/v1/docker/resource"
    ],
    "serial": false,
    "privileged": true
  },
  "permissions": [
    "account",
    "broker.containers.start",
    "broker.containers.stop",
    "broker.containers.restart",
    "broker.docker.resource"
  ]
}
