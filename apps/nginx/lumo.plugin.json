{
  "schemaVersion": 1,
  "id": "websites",
  "name": "Nginx",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "hostApiVersion": 1,
  "icon": "IconGlobe",
  "window": {
    "width": 960,
    "height": 650,
    "minWidth": 390,
    "minHeight": 380
  },
  "requiredPackage": "nginx",
  "backend": {
    "protocolVersion": 1,
    "routes": [
      "GET /api/v1/websites",
      "GET /api/v1/websites/logs",
      "POST /api/v1/websites/save"
    ],
    "serial": false,
    "privileged": true
  },
  "permissions": [
    "account",
    "broker.websites.save"
  ]
}
